{
  "name": "rrinterior-construction",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mts",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sqlite-to-pg.mts",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-import.mts",
    "db:backup": "node scripts/backup.mts",
    "db:restore": "node scripts/restore.mts",
    "db:user": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.mts",
    "r2:setup": "node --env-file-if-exists=.env.local scripts/r2-setup.mts",
    "db:migrate-media": "node --env-file-if-exists=.env.local scripts/migrate-media-to-r2.mts",
    "db:media-cleanup": "node --env-file-if-exists=.env.local scripts/media-cleanup.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@gsap/react": "^2.1.2",
    "better-sqlite3": "^13.0.3",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
